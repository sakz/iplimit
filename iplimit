#!/usr/bin/env bash

set -Eeuo pipefail

readonly PROGRAM_NAME="iplimit"
readonly VERSION="1.1.0"
readonly CONFIG_FILE="${IPLIMIT_CONFIG_FILE:-/etc/iplimit.conf}"
readonly STATE_DIR="${IPLIMIT_STATE_DIR:-/run/iplimit}"
readonly OWNER_FILE="$STATE_DIR/owner.env"
readonly CLIENTS_FILE="$STATE_DIR/clients.tsv"
readonly SERVICE_NAME="iplimit.service"
readonly IPV4_FILTER_PREF="49150"
readonly IPV6_FILTER_PREF="49151"
readonly LEGACY_REDIRECT_PREF="49152"

RATE_MBIT="20"
INTERFACE="auto"
IFB_NAME="ifb-iplimit"
POLL_INTERVAL="2"
CLIENT_TTL="300"
UNSHAPED_RATE_MBIT="100000"
EXCLUDE_IPS=""
NETWORK_TOUCHED=0

log() {
    printf '[%s] %s\n' "$PROGRAM_NAME" "$*"
}

warn() {
    printf '[%s] 警告：%s\n' "$PROGRAM_NAME" "$*" >&2
}

die() {
    printf '[%s] 错误：%s\n' "$PROGRAM_NAME" "$*" >&2
    exit 1
}

is_valid_rate() {
    local value=${1:-}
    [[ "$value" =~ ^[0-9]+([.][0-9]+)?$ ]] && awk -v value="$value" 'BEGIN { exit !(value > 0) }'
}

is_positive_integer() {
    [[ "${1:-}" =~ ^[1-9][0-9]*$ ]]
}

is_valid_interface_name() {
    local name=${1:-}
    [[ "$name" =~ ^[a-zA-Z0-9_.:-]+$ && ${#name} -le 15 ]]
}

is_ipv4_address() {
    local ip=${1:-}
    local part

    [[ "$ip" =~ ^[0-9]+([.][0-9]+){3}$ ]] || return 1
    local old_ifs=$IFS
    IFS=.
    # shellcheck disable=SC2206
    local parts=($ip)
    IFS=$old_ifs
    [[ ${#parts[@]} -eq 4 ]] || return 1
    for part in "${parts[@]}"; do
        [[ "$part" =~ ^[0-9]+$ ]] || return 1
        ((10#$part <= 255)) || return 1
    done
}

is_ipv6_address() {
    local ip=${1:-}
    local left right compressed=0 part index slots=0
    local -a segments=()

    [[ "$ip" == *:* && "$ip" =~ ^[0-9A-Fa-f:.]+$ ]] || return 1
    if [[ "$ip" == *::* ]]; then
        compressed=1
        left=${ip%%::*}
        right=${ip#*::}
        [[ "$right" != *::* ]] || return 1
    else
        [[ "$ip" != :* && "$ip" != *: ]] || return 1
        left=$ip
        right=""
    fi

    if [[ -n "$left" ]]; then
        local old_ifs=$IFS
        IFS=:
        # shellcheck disable=SC2206
        local left_parts=($left)
        IFS=$old_ifs
        segments+=("${left_parts[@]}")
    fi
    if [[ -n "$right" ]]; then
        local old_ifs=$IFS
        IFS=:
        # shellcheck disable=SC2206
        local right_parts=($right)
        IFS=$old_ifs
        segments+=("${right_parts[@]}")
    fi

    for ((index = 0; index < ${#segments[@]}; index++)); do
        part=${segments[$index]}
        [[ -n "$part" ]] || return 1
        if [[ "$part" == *.* ]]; then
            [[ $index -eq $((${#segments[@]} - 1)) ]] || return 1
            is_ipv4_address "$part" || return 1
            slots=$((slots + 2))
        else
            [[ "$part" =~ ^[0-9A-Fa-f]{1,4}$ ]] || return 1
            slots=$((slots + 1))
        fi
    done

    if [[ "$compressed" == "1" ]]; then
        ((slots < 8))
    else
        ((slots == 8))
    fi
}

is_ip_address() {
    local ip=${1:-}
    if [[ "$ip" == *:* ]]; then
        is_ipv6_address "$ip"
    else
        is_ipv4_address "$ip"
    fi
}

extract_clients() {
    local local_addresses=${1:-}
    awk -v addresses="$local_addresses" '
        BEGIN {
            count = split(addresses, values, /[[:space:]]+/)
            for (i = 1; i <= count; i++) {
                if (values[i] != "") local_ip[values[i]] = 1
            }
        }
        ($1 == "tcp" || $1 == "udp") || (($1 == "ipv4" || $1 == "ipv6") && ($3 == "tcp" || $3 == "udp")) {
            source = ""
            destination = ""
            for (i = 1; i <= NF; i++) {
                if (source == "" && $i ~ /^src=/) {
                    source = substr($i, 5)
                } else if (destination == "" && $i ~ /^dst=/) {
                    destination = substr($i, 5)
                }
                if (source != "" && destination != "") break
            }
            if (source != "" && local_ip[destination] && !local_ip[source]) print source
        }
    '
}

filter_spec() {
    local direction=${1:-}
    local ip=${2:-}
    local protocol key suffix

    is_ip_address "$ip" || return 1
    case "$direction" in
        download) key="dst_ip" ;;
        upload) key="src_ip" ;;
        *) return 1 ;;
    esac

    if [[ "$ip" == *:* ]]; then
        protocol="ipv6"
        suffix="128"
    else
        protocol="ip"
        suffix="32"
    fi
    printf '%s|%s|%s/%s\n' "$protocol" "$key" "$ip" "$suffix"
}

filter_pref() {
    local protocol=${1:-}
    case "$protocol" in
        ip) printf '%s\n' "$IPV4_FILTER_PREF" ;;
        ipv6) printf '%s\n' "$IPV6_FILTER_PREF" ;;
        *) return 1 ;;
    esac
}

usage() {
    cat <<'EOF'
IPLimit - Debian 12 按客户端 IP 独立限速工具

用法：
  iplimit                         打开交互式菜单
  iplimit start [Mbps] [网卡]      启动或更新限速（默认：20、自动识别网卡）
  iplimit set <Mbps>              修改每个客户端的限速并重启服务
  iplimit status                  查看服务、队列和配置状态
  iplimit clients                 查看已发现的客户端 IP 和类别 ID
  iplimit stop                    停止限速并清理本工具创建的 tc/IFB 配置
  iplimit help                    显示帮助
  iplimit version                 显示版本

示例：
  sudo iplimit start 20
  sudo iplimit start 12.5 eth0
  sudo iplimit set 50
  sudo iplimit status

每个直连客户端 IP 都有独立的上传和下载上限，支持 TCP、UDP、IPv4 和 IPv6。
未识别的流量不会进入 IFB，也不会被限速。
EOF
}

load_config() {
    if [[ -f "$CONFIG_FILE" ]]; then
        # 该文件由 root 管理，只包含简单变量赋值。
        # shellcheck disable=SC1090
        source "$CONFIG_FILE"
    fi
}

validate_config() {
    is_valid_rate "$RATE_MBIT" || die "RATE_MBIT 必须是正数，当前值：$RATE_MBIT"
    is_positive_integer "$POLL_INTERVAL" || die "POLL_INTERVAL 必须是正整数"
    is_positive_integer "$CLIENT_TTL" || die "CLIENT_TTL 必须是正整数"
    is_valid_rate "$UNSHAPED_RATE_MBIT" || die "UNSHAPED_RATE_MBIT 必须是正数"
    [[ "$INTERFACE" == "auto" ]] || is_valid_interface_name "$INTERFACE" || die "网卡名称无效（最长 15 个字符）：$INTERFACE"
    is_valid_interface_name "$IFB_NAME" || die "IFB 名称无效（最长 15 个字符）：$IFB_NAME"

    local ip
    for ip in $EXCLUDE_IPS; do
        is_ip_address "$ip" || die "EXCLUDE_IPS 中的地址无效：$ip"
    done
}

require_root() {
    [[ $(id -u) -eq 0 ]] || die "此命令需要 root 权限，请使用 sudo 运行"
}

require_commands() {
    local command_name
    for command_name in ip tc conntrack modprobe systemctl systemd-notify awk sort; do
        command -v "$command_name" >/dev/null 2>&1 || die "缺少依赖：${command_name}（请重新运行 install.sh）"
    done
}

detect_interface() {
    local detected
    if [[ "$INTERFACE" != "auto" ]]; then
        ip link show dev "$INTERFACE" >/dev/null 2>&1 || die "网卡不存在：$INTERFACE"
        printf '%s\n' "$INTERFACE"
        return
    fi

    detected=$(ip -4 route show default 2>/dev/null | awk '/^default/ { for (i = 1; i <= NF; i++) if ($i == "dev") { print $(i + 1); exit } }')
    if [[ -z "$detected" ]]; then
        detected=$(ip -6 route show default 2>/dev/null | awk '/^default/ { for (i = 1; i <= NF; i++) if ($i == "dev") { print $(i + 1); exit } }')
    fi
    [[ -n "$detected" ]] || die "无法识别默认网卡，请手动指定：iplimit start <Mbps> <网卡>"
    printf '%s\n' "$detected"
}

save_config() {
    local target_dir tmp
    target_dir=$(dirname "$CONFIG_FILE")
    mkdir -p "$target_dir"
    tmp=$(mktemp "$target_dir/.iplimit.conf.XXXXXX")
    chmod 600 "$tmp"
    {
        printf '# 由 iplimit 管理。修改后请运行：sudo iplimit start\n'
        printf 'RATE_MBIT="%s"\n' "$RATE_MBIT"
        printf 'INTERFACE="%s"\n' "$INTERFACE"
        printf 'IFB_NAME="%s"\n' "$IFB_NAME"
        printf 'POLL_INTERVAL="%s"\n' "$POLL_INTERVAL"
        printf 'CLIENT_TTL="%s"\n' "$CLIENT_TTL"
        printf 'UNSHAPED_RATE_MBIT="%s"\n' "$UNSHAPED_RATE_MBIT"
        printf 'EXCLUDE_IPS="%s"\n' "$EXCLUDE_IPS"
    } >"$tmp"
    mv -f "$tmp" "$CONFIG_FILE"
}

is_excluded() {
    local candidate=$1
    local excluded
    for excluded in $EXCLUDE_IPS; do
        [[ "$candidate" == "$excluded" ]] && return 0
    done
    return 1
}

root_qdisc_line() {
    local device=$1
    tc qdisc show dev "$device" 2>/dev/null | awk '$0 ~ / root / { print; exit }'
}

owner_value() {
    local key=$1
    [[ -f "$OWNER_FILE" ]] || return 1
    awk -F= -v key="$key" '$1 == key { print substr($0, index($0, "=") + 1); exit }' "$OWNER_FILE"
}

assert_safe_root_qdisc() {
    local device=$1
    local line kind handle owner_interface
    line=$(root_qdisc_line "$device")
    kind=$(awk '{ print $2 }' <<<"$line")
    handle=$(awk '{ print $3 }' <<<"$line")

    case "$kind" in
        "") return 0 ;;
        noqueue|mq|fq|fq_codel|pfifo_fast)
            [[ "$handle" == "0:" ]] && return 0
            ;;
        htb)
            owner_interface=$(owner_value INTERFACE 2>/dev/null || true)
            [[ "$owner_interface" == "$device" && "$line" == "qdisc htb 1: root"* ]] && return 0
            ;;
    esac

    die "拒绝替换 $device 上已有的根队列 '$kind'，请先移除或迁移现有 tc 配置"
}

write_owner_file() {
    local device=$1
    local created_clsact=$2
    local tmp="$OWNER_FILE.tmp.$$"
    {
        printf 'INTERFACE=%s\n' "$device"
        printf 'IFB_NAME=%s\n' "$IFB_NAME"
        printf 'CREATED_CLSACT=%s\n' "$created_clsact"
        printf 'RULESET_VERSION=2\n'
    } >"$tmp"
    mv -f "$tmp" "$OWNER_FILE"
}

legacy_redirect_matches() {
    local device=$1
    local expected_ifb=$2
    local rules
    rules=$(tc filter show dev "$device" ingress pref "$LEGACY_REDIRECT_PREF" 2>/dev/null) || return 1
    grep -q 'matchall' <<<"$rules" \
        && grep -Fq "mirred (Egress Redirect to device $expected_ifb)" <<<"$rules"
}

setup_network() {
    local device=$1
    local created_clsact=0
    local previous_owner previous_created_clsact previous_ruleset
    local reclaim_new_filters=0
    local reclaim_legacy_filter=0

    mkdir -p "$STATE_DIR"
    assert_safe_root_qdisc "$device"
    previous_owner=$(owner_value INTERFACE 2>/dev/null || true)
    previous_ruleset=$(owner_value RULESET_VERSION 2>/dev/null || true)
    if tc filter show dev "$device" ingress pref "$IPV4_FILTER_PREF" 2>/dev/null | grep -q . \
        || tc filter show dev "$device" ingress pref "$IPV6_FILTER_PREF" 2>/dev/null | grep -q .; then
        if [[ "$previous_owner" == "$device" && "$previous_ruleset" == "2" ]]; then
            reclaim_new_filters=1
        else
            die "$device 的入口过滤器优先级 $IPV4_FILTER_PREF/$IPV6_FILTER_PREF 已被占用"
        fi
    fi
    if [[ "$previous_owner" == "$device" && -z "$previous_ruleset" ]] \
        && legacy_redirect_matches "$device" "$IFB_NAME"; then
        reclaim_legacy_filter=1
    fi
    previous_created_clsact=$(owner_value CREATED_CLSACT 2>/dev/null || printf '0')

    if ip link show dev "$IFB_NAME" >/dev/null 2>&1; then
        local owned_ifb
        owned_ifb=$(owner_value IFB_NAME 2>/dev/null || true)
        [[ "$owned_ifb" == "$IFB_NAME" ]] || die "IFB 设备已存在且不属于 IPLimit：$IFB_NAME"
    fi

    if [[ "$reclaim_new_filters" == "1" ]]; then
        NETWORK_TOUCHED=1
        tc filter del dev "$device" ingress pref "$IPV4_FILTER_PREF" protocol ip 2>/dev/null || true
        tc filter del dev "$device" ingress pref "$IPV6_FILTER_PREF" protocol ipv6 2>/dev/null || true
    fi
    if [[ "$reclaim_legacy_filter" == "1" ]]; then
        NETWORK_TOUCHED=1
        tc filter del dev "$device" ingress pref "$LEGACY_REDIRECT_PREF" protocol all 2>/dev/null || true
    fi

    write_owner_file "$device" "$previous_created_clsact"
    NETWORK_TOUCHED=1
    if ! ip link show dev "$IFB_NAME" >/dev/null 2>&1; then
        modprobe ifb 2>/dev/null || true
        ip link add "$IFB_NAME" type ifb
    fi
    ip link set dev "$IFB_NAME" up

    if ! tc qdisc show dev "$device" | grep -q '^qdisc clsact '; then
        tc qdisc add dev "$device" clsact
        created_clsact=1
    else
        created_clsact=$previous_created_clsact
    fi

    write_owner_file "$device" "$created_clsact"

    tc qdisc replace dev "$device" root handle 1: htb default 1
    tc class replace dev "$device" parent 1: classid 1:1 htb \
        rate "${UNSHAPED_RATE_MBIT}mbit" ceil "${UNSHAPED_RATE_MBIT}mbit" quantum 15140
    tc qdisc replace dev "$device" parent 1:1 handle 2: fq_codel

    tc qdisc replace dev "$IFB_NAME" root handle 1: htb default 1
    tc class replace dev "$IFB_NAME" parent 1: classid 1:1 htb \
        rate "${UNSHAPED_RATE_MBIT}mbit" ceil "${UNSHAPED_RATE_MBIT}mbit" quantum 15140
    tc qdisc replace dev "$IFB_NAME" parent 1:1 handle 2: fq_codel
}

cleanup_network() {
    local device=${1:-}
    local owned_device owned_ifb created_clsact ruleset_version

    if [[ ! -f "$OWNER_FILE" ]]; then
        NETWORK_TOUCHED=0
        return 0
    fi

    if [[ -z "$device" ]]; then
        owned_device=$(owner_value INTERFACE 2>/dev/null || true)
        device=$owned_device
    fi
    owned_ifb=$(owner_value IFB_NAME 2>/dev/null || true)
    created_clsact=$(owner_value CREATED_CLSACT 2>/dev/null || printf '0')
    ruleset_version=$(owner_value RULESET_VERSION 2>/dev/null || true)

    if [[ -n "$device" ]] && ip link show dev "$device" >/dev/null 2>&1; then
        if [[ "$ruleset_version" == "2" ]]; then
            tc filter del dev "$device" ingress pref "$IPV4_FILTER_PREF" protocol ip 2>/dev/null || true
            tc filter del dev "$device" ingress pref "$IPV6_FILTER_PREF" protocol ipv6 2>/dev/null || true
        elif [[ -z "$ruleset_version" ]] && legacy_redirect_matches "$device" "$owned_ifb"; then
            tc filter del dev "$device" ingress pref "$LEGACY_REDIRECT_PREF" protocol all 2>/dev/null || true
        fi
        if [[ $(owner_value INTERFACE 2>/dev/null || true) == "$device" && $(root_qdisc_line "$device") == "qdisc htb 1: root"* ]]; then
            tc qdisc del dev "$device" root 2>/dev/null || true
        fi
        if [[ "$created_clsact" == "1" ]] \
            && ! tc filter show dev "$device" ingress 2>/dev/null | grep -q . \
            && ! tc filter show dev "$device" egress 2>/dev/null | grep -q .; then
            tc qdisc del dev "$device" clsact 2>/dev/null || true
        fi
    fi

    if [[ -n "$owned_ifb" ]] && ip link show dev "$owned_ifb" >/dev/null 2>&1; then
        tc qdisc del dev "$owned_ifb" root 2>/dev/null || true
        ip link set dev "$owned_ifb" down 2>/dev/null || true
        ip link delete "$owned_ifb" type ifb 2>/dev/null || true
    fi

    rm -f "$OWNER_FILE" "$CLIENTS_FILE"
    rmdir "$STATE_DIR" 2>/dev/null || true
    NETWORK_TOUCHED=0
}

local_addresses() {
    local device=$1
    ip -o addr show dev "$device" scope global | awk '{ address=$4; sub(/\/.*/, "", address); print address }' | paste -sd ' ' -
}

list_conntrack_clients() {
    local addresses=$1
    {
        conntrack -L -f ipv4 -o extended 2>/dev/null || true
        conntrack -L -f ipv6 -o extended 2>/dev/null || true
    } | extract_clients "$addresses" | sort -u
}

add_client_class() {
    local device=$1
    local ip=$2
    local class_num=$3
    local class_hex filter_handle filter_priority protocol download_key download_cidr upload_key upload_cidr
    local download_spec upload_spec

    class_hex=$(printf '%x' "$class_num")
    filter_handle="0x$class_hex"
    download_spec=$(filter_spec download "$ip")
    upload_spec=$(filter_spec upload "$ip")
    IFS='|' read -r protocol download_key download_cidr <<<"$download_spec"
    IFS='|' read -r _ upload_key upload_cidr <<<"$upload_spec"
    filter_priority=$(filter_pref "$protocol")

    if ! tc class add dev "$device" parent 1: classid "1:$class_hex" htb \
        rate "${RATE_MBIT}mbit" ceil "${RATE_MBIT}mbit" quantum 1514; then
        return 1
    fi
    tc qdisc add dev "$device" parent "1:$class_hex" handle "$class_hex:" fq_codel || return 1
    tc filter add dev "$device" parent 1: pref "$filter_priority" protocol "$protocol" \
        handle "$filter_handle" flower \
        "$download_key" "$download_cidr" classid "1:$class_hex" || return 1

    tc class add dev "$IFB_NAME" parent 1: classid "1:$class_hex" htb \
        rate "${RATE_MBIT}mbit" ceil "${RATE_MBIT}mbit" quantum 1514 || return 1
    tc qdisc add dev "$IFB_NAME" parent "1:$class_hex" handle "$class_hex:" fq_codel || return 1
    tc filter add dev "$IFB_NAME" parent 1: pref "$filter_priority" protocol "$protocol" \
        handle "$filter_handle" flower \
        "$upload_key" "$upload_cidr" classid "1:$class_hex" || return 1
    tc filter add dev "$device" ingress pref "$filter_priority" protocol "$protocol" \
        handle "$filter_handle" flower "$upload_key" "$upload_cidr" \
        action mirred egress redirect dev "$IFB_NAME" || return 1
}

remove_client_class() {
    local device=$1
    local ip=$2
    local class_num=$3
    local class_hex filter_handle filter_priority protocol
    class_hex=$(printf '%x' "$class_num")
    filter_handle="0x$class_hex"
    if [[ "$ip" == *:* ]]; then
        protocol="ipv6"
    else
        protocol="ip"
    fi
    filter_priority=$(filter_pref "$protocol")

    tc filter del dev "$device" ingress pref "$filter_priority" protocol "$protocol" \
        handle "$filter_handle" flower 2>/dev/null || true
    tc filter del dev "$device" parent 1: pref "$filter_priority" protocol "$protocol" \
        handle "$filter_handle" flower 2>/dev/null || true
    tc qdisc del dev "$device" parent "1:$class_hex" 2>/dev/null || true
    tc class del dev "$device" classid "1:$class_hex" 2>/dev/null || true
    tc filter del dev "$IFB_NAME" parent 1: pref "$filter_priority" protocol "$protocol" \
        handle "$filter_handle" flower 2>/dev/null || true
    tc qdisc del dev "$IFB_NAME" parent "1:$class_hex" 2>/dev/null || true
    tc class del dev "$IFB_NAME" classid "1:$class_hex" 2>/dev/null || true
}

daemon_main() {
    require_root
    require_commands
    load_config
    validate_config

    local device addresses now ip candidate class_num tmp
    local shutdown_done=0
    device=$(detect_interface)
    addresses=$(local_addresses "$device")
    [[ -n "$addresses" ]] || die "网卡 $device 上没有找到全局 IP 地址"

    daemon_shutdown() {
        [[ "$shutdown_done" == "1" ]] && return
        shutdown_done=1
        trap - EXIT INT TERM
        if [[ "$NETWORK_TOUCHED" == "1" ]]; then
            cleanup_network "$device"
        fi
    }
    trap 'daemon_shutdown; exit 0' INT TERM
    trap 'daemon_shutdown' EXIT

    setup_network "$device"

    if [[ -n ${NOTIFY_SOCKET:-} ]]; then
        systemd-notify --ready --status="正在 $device 上按客户端限制为 ${RATE_MBIT} Mbps"
    fi

    # 这些映射只属于当前守护进程；服务重启时会重建 tc 状态。
    declare -A ip_class=()
    declare -A class_ip=()
    declare -A last_seen=()

    log "已在 $device 启用：每个客户端每个方向 ${RATE_MBIT} Mbps"

    while true; do
        now=$(date +%s)
        while IFS= read -r ip; do
            [[ -n "$ip" ]] || continue
            is_excluded "$ip" && continue
            last_seen["$ip"]=$now
            if [[ -z ${ip_class[$ip]+x} ]]; then
                class_num=""
                for ((candidate = 10; candidate <= 65000; candidate++)); do
                    if [[ -z ${class_ip[$candidate]+x} ]]; then
                        class_num=$candidate
                        break
                    fi
                done
                if [[ -z "$class_num" ]]; then
                    warn "没有可供客户端 $ip 使用的 tc 类别 ID"
                    continue
                fi
                if add_client_class "$device" "$ip" "$class_num"; then
                    ip_class["$ip"]=$class_num
                    class_ip["$class_num"]=$ip
                    log "已添加客户端 ${ip}，类别 1:$(printf '%x' "$class_num")"
                else
                    warn "无法为客户端 $ip 添加 tc 类别"
                    remove_client_class "$device" "$ip" "$class_num"
                    unset 'last_seen[$ip]'
                fi
            fi
        done < <(list_conntrack_clients "$addresses")

        for ip in "${!ip_class[@]}"; do
            if ((now - last_seen[$ip] > CLIENT_TTL)); then
                class_num=${ip_class[$ip]}
                remove_client_class "$device" "$ip" "$class_num"
                unset 'class_ip[$class_num]' 'ip_class[$ip]' 'last_seen[$ip]'
                log "已移除空闲客户端 $ip"
            fi
        done

        tmp="$CLIENTS_FILE.tmp.$$"
        {
            printf 'IP\t类别\t最后活跃时间戳\n'
            for ip in "${!ip_class[@]}"; do
                printf '%s\t1:%x\t%s\n' "$ip" "${ip_class[$ip]}" "${last_seen[$ip]}"
            done | sort
        } >"$tmp"
        mv -f "$tmp" "$CLIENTS_FILE"
        sleep "$POLL_INTERVAL"
    done
}

start_limit() {
    require_root
    require_commands
    load_config

    if [[ -n ${1:-} ]]; then
        RATE_MBIT=$1
    fi
    if [[ -n ${2:-} ]]; then
        INTERFACE=$2
    fi
    [[ -z ${3:-} ]] || die "参数过多。用法：iplimit start [Mbps] [网卡]"
    validate_config
    save_config

    systemctl daemon-reload
    systemctl enable --quiet "$SERVICE_NAME"
    systemctl restart "$SERVICE_NAME"
    systemctl is-active --quiet "$SERVICE_NAME" || die "服务启动失败，请检查：journalctl -u $SERVICE_NAME -n 100 --no-pager"
    log "已启动：每个客户端 ${RATE_MBIT} Mbps（网卡：${INTERFACE}）"
}

set_limit() {
    [[ -n ${1:-} && -z ${2:-} ]] || die "用法：iplimit set <Mbps>"
    start_limit "$1"
}

stop_limit() {
    require_root
    load_config
    systemctl disable --now "$SERVICE_NAME" 2>/dev/null || true
    cleanup_network
    log "已停止，并清理 IPLimit 创建的 tc 规则和 IFB 设备"
}

show_clients() {
    require_root
    if [[ -f "$CLIENTS_FILE" ]]; then
        column -t -s $'\t' "$CLIENTS_FILE" 2>/dev/null || cat "$CLIENTS_FILE"
    else
        log "暂无客户端记录（服务可能未运行，或尚未完成首次扫描）"
    fi
}

show_status() {
    require_root
    load_config
    validate_config
    local device
    device=$(detect_interface)

    if systemctl is-active --quiet "$SERVICE_NAME"; then
        printf '服务状态：运行中\n'
    else
        printf '服务状态：未运行\n'
    fi
    if systemctl is-enabled --quiet "$SERVICE_NAME" 2>/dev/null; then
        printf '开机启动：已启用\n'
    else
        printf '开机启动：未启用\n'
    fi
    printf '公网网卡：%s\n' "$device"
    printf 'IFB 设备：%s\n' "$IFB_NAME"
    printf '限速配置：每个客户端每个方向 %s Mbps\n' "$RATE_MBIT"
    printf '支持协议：IPv4/IPv6、TCP/UDP\n'
    printf '空闲清理：%s 秒\n' "$CLIENT_TTL"

    printf '\n%s 上的根队列：\n' "$device"
    tc qdisc show dev "$device" 2>/dev/null || true
    if ip link show dev "$IFB_NAME" >/dev/null 2>&1; then
        printf '\n%s 上的根队列：\n' "$IFB_NAME"
        tc qdisc show dev "$IFB_NAME" 2>/dev/null || true
    fi
    printf '\n客户端：\n'
    show_clients
}

interactive_menu() {
    require_root
    while true; do
        cat <<'EOF'

IPLimit
  1) 启动或修改每个客户端的限速
  2) 查看状态
  3) 查看活跃客户端
  4) 停止并清理
  5) 退出
EOF
        read -r -p "请选择 [1-5]：" choice
        case "$choice" in
            1)
                read -r -p "每个客户端的限速 Mbps [20]：" rate
                rate=${rate:-20}
                read -r -p "公网网卡 [auto]：" iface
                iface=${iface:-auto}
                start_limit "$rate" "$iface"
                ;;
            2) show_status ;;
            3) show_clients ;;
            4) stop_limit ;;
            5) return 0 ;;
            *) warn "请输入 1 到 5 之间的数字" ;;
        esac
    done
}

main() {
    local command=${1:-}
    if [[ $# -gt 0 ]]; then
        shift
    fi
    case "$command" in
        "") interactive_menu ;;
        start) start_limit "$@" ;;
        set) set_limit "$@" ;;
        status) [[ $# -eq 0 ]] || die "用法：iplimit status"; show_status ;;
        clients) [[ $# -eq 0 ]] || die "用法：iplimit clients"; show_clients ;;
        stop|clean) [[ $# -eq 0 ]] || die "用法：iplimit stop"; stop_limit ;;
        help|-h|--help) usage ;;
        version|-V|--version) printf '%s %s\n' "$PROGRAM_NAME" "$VERSION" ;;
        daemon-internal) [[ $# -eq 0 ]] || die "守护进程参数无效"; daemon_main ;;
        cleanup-internal) [[ $# -eq 0 ]] || die "清理参数无效"; require_root; load_config; cleanup_network ;;
        *) die "未知命令：${command}（请运行 iplimit help 查看帮助）" ;;
    esac
}

if [[ ${IPLIMIT_LIBRARY_ONLY:-0} != "1" ]]; then
    main "$@"
fi
